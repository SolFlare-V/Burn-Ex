# Normalize line endings
* text=auto

# Force LF for Python, JS, TS, JSON, YAML, Markdown
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files — no line ending conversion
*.pkl binary
*.tflite binary
*.jpg binary
*.jpeg binary
*.png binary
*.woff2 binary
*.ico binary
